{
  "manifest_version": 3,
  "name": "Sorayura Spotify Web",
  "version": "0.1.0",
  "description": "Connect the Spotify Web player to your local Sorayura widgets.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://open.spotify.com/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "js": [
        "page.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Sorayura Spotify Web"
  }
}
